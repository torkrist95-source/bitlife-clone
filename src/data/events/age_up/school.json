    "weight": 6,
    "text": "You've been assigned a big school project due next week.",
    "choices": [
      {
        "label": "Put in real effort",
        "outcomes": [
          { "weight": 6, "effects": { "smarts": 3, "happiness": 3, "reputation": 1 }, "resultText": "You put real effort into the project, and it showed -- you got one of the best grades in the class." },
          { "weight": 4, "effects": { "smarts": 1, "happiness": 1 }, "resultText": "You worked hard on it, though it didn't turn out quite as polished as you'd hoped." }
        ]
      },
      {
        "label": "Throw it together last minute",
        "outcomes": [
          { "weight": 5, "effects": { "happiness": 2 }, "resultText": "You threw it together the night before. It wasn't great, but it was done." },
          { "weight": 5, "effects": { "smarts": -1, "happiness": -1 }, "resultText": "Rushing it the night before was obvious to everyone, including your teacher." }
        ]
      }
    ]
  },
  {
