  {
    "id": "spelling_test",
    "trigger": "age_up",
    "conditions": { "minAge": 6, "maxAge": 10 },
    "requires": [{ "path": "education.status", "op": "==", "value": "elementary" }],
    "weight": 8,
    "text": "Your teacher announced a spelling test tomorrow.",
    "choices": [
      {
        "label": "Study",
        "outcomes": [
          { "weight": 7, "effects": { "smarts": 2, "happiness": 1 }, "resultText": "You practiced your spelling words and aced the test." },
          { "weight": 3, "effects": { "smarts": 1, "happiness": -1 }, "resultText": "You studied hard, but still mixed up a couple of tricky words." }
        ]
      },
      {
        "label": "Don't study",
        "outcomes": [
          { "weight": 6, "effects": { "happiness": 2 }, "resultText": "You skipped studying and played instead. The test was harder than you expected." },
          { "weight": 4, "effects": { "smarts": -1, "happiness": -1 }, "resultText": "You didn't study, and it showed -- you missed several words you should have known." }
        ]
      }
    ]
  },
  {
    "id": "algebra_test",
    "trigger": "age_up",
    "conditions": { "minAge": 12, "maxAge": 17 },
    "requires": [{ "path": "education.gradeLevel", "op": ">=", "value": 7 }],
    "weight": 8,
    "text": "Your algebra test is tomorrow.",
    "choices": [
      {
        "label": "Study",
        "outcomes": [
          { "weight": 6, "effects": { "smarts": 2 }, "resultText": "You studied for a couple hours and it paid off -- the test felt manageable." },
          { "weight": 4, "effects": { "smarts": 1, "happiness": -1 }, "resultText": "You studied, but a few problems on the test still tripped you up." }
        ]
      },
      {
        "label": "Don't study",
        "outcomes": [
          { "weight": 5, "effects": { "happiness": 1 }, "resultText": "You skipped studying. The test went okay, but you were guessing on more than a few questions." },
          { "weight": 5, "effects": { "smarts": -1, "happiness": -2 }, "resultText": "You didn't study and it caught up with you -- you struggled through most of the test." }
        ]
      },
      {
        "label": "Ask a classmate for help",
        "dynamic": "ask_classmate_for_help"
      }
    ]
  },
  {
    "id": "final_exams",
    "trigger": "age_up",
    "conditions": { "minAge": 15, "maxAge": 17 },
    "requires": [{ "path": "education.gradeLevel", "op": ">=", "value": 10 }],
    "weight": 7,
    "text": "Your final exams are approaching.",
    "choices": [
      {
        "label": "Study Hard",
        "outcomes": [
          { "weight": 7, "effects": { "smarts": 3, "happiness": -2 }, "resultText": "You spent every free hour studying. It was exhausting, but you walked into finals feeling prepared." },
          { "weight": 3, "effects": { "smarts": 2, "happiness": -4 }, "resultText": "You studied around the clock and burned yourself out a little, but you covered everything you needed to." }
        ]
      },
      {
        "label": "Study Normally",
        "outcomes": [
          { "weight": 6, "effects": { "smarts": 1, "happiness": 1 }, "resultText": "You kept a normal study schedule and felt reasonably ready for finals." },
          { "weight": 4, "effects": { "happiness": -1 }, "resultText": "Your normal amount of studying left a few gaps you noticed too late." }
        ]
      },
      {
        "label": "Don't Study",
        "outcomes": [
          { "weight": 4, "effects": { "happiness": 3 }, "resultText": "You decided finals week wasn't worth the stress and relaxed instead. Risky, but your week was a lot more fun." },
          { "weight": 6, "effects": { "smarts": -2, "happiness": -2 }, "resultText": "You didn't study at all, and finals week hit you like a truck." }
        ]
      },
      {
        "label": "Ask Teacher for Help",
        "dynamic": "ask_teacher_for_help"
      }
    ]
  },
  {
    "id": "school_project",
    "trigger": "age_up",
    "conditions": { "minAge": 7, "maxAge": 13 },
